<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build only, do not run in the /master pipeline.
       These Mac2Driver Appium tests drive the MAUI Blazor Hybrid Desktop host (Mac Catalyst) as a black
       box on macOS; they require a running backend on :5180, a Debug-built Desktop .app, a running Appium
       server (default http://localhost:4723) with the mac2 driver installed, and the one-time local grants
       (Accessibility, Screen Recording, Safari web-developer features). Execute via
       scripts/local/test-appium-mac.sh against a live system — never via `dotnet test` in the pipeline.
       No src/ project references: the suite treats the installed app as a black box and asserts only on
       data-testid selectors reachable in the WKWebView context. Mirrors ServiceDelivery.Client.Appium
       (XCUITest/iOS) — a separate project because mac2 and XCUITest are different Appium drivers. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="8.3.0" />
    <!-- Companion to Selenium.WebDriver (transitively pulled by Appium.WebDriver 8.3.0 → Selenium
         4.44.0); provides WebDriverWait for the ≥15 s SignalR polling in the fleet-map tests. -->
    <PackageReference Include="Selenium.Support" Version="4.44.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="OpenQA.Selenium" />
    <Using Include="OpenQA.Selenium.Appium" />
    <Using Include="OpenQA.Selenium.Support.UI" />
  </ItemGroup>

</Project>
