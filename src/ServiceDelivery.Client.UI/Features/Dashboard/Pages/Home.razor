@page "/"
@using ServiceDelivery.Client.Core.ViewModels
@inject AppStartViewModel ViewModel
@inject NavigationManager Navigation

@code {
    protected override async Task OnInitializedAsync()
    {
        // ResolveStartRouteAsync always returns a concrete route (persona home for a valid token,
        // /login otherwise), so "/" always redirects and never renders a blank body (BUG-050).
        var route = await ViewModel.ResolveStartRouteAsync();

        Navigation.NavigateTo(route, replace: true);
    }
}
