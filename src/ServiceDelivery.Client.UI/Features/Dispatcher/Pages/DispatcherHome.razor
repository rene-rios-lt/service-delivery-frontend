@page "/dispatcher"
@using ServiceDelivery.Client.Core.ViewModels
@using ServiceDelivery.Client.UI.Features.Dispatcher.Components
@implements IDisposable
@inject DispatcherFleetViewModel ViewModel
@inject DispatcherRequestQueueViewModel QueueViewModel

@* FE-003/FE-004 dispatcher fleet command centre (mockup: dispatcher-dashboard). Renders into the shared
   PersonaShell body (FE-021 supplies the app bar). Two columns: the live FleetMap on the left and the ACTIVE
   REQUESTS queue rail on the right (FE-004). An empty offline-alert banner slot sits above the layout (FE-006
   wires it). The page owns both ViewModel lifecycles: load the fleet snapshot + queue and start their hubs on
   mount, stop the hubs on dispose, and re-render on either StateChanged. *@

<div class="sd-dispatcher">
    @* Offline-alert banner slot — empty in FE-003; wired to the rep-offline event in FE-006. *@
    <div class="sd-dispatcher__banner" data-testid="dispatcher-offline-banner"></div>

    <div class="sd-dispatcher-layout" data-testid="dispatcher-dashboard">
        <div class="sd-dispatcher-layout__map" data-testid="dispatcher-map-column">
            <FleetMap />
        </div>

        <section class="sd-dispatcher-layout__rail" data-testid="dispatcher-queue-rail">
            <div class="sd-dispatcher-rail__head sd-dispatcher-rail__head--split">
                <span>ACTIVE REQUESTS</span>
                <span class="sd-queue-count" data-testid="queue-active-count">@QueueViewModel.Queue.Count active</span>
            </div>
            <RequestQueueRail />
        </section>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateChanged += OnStateChanged;
        QueueViewModel.StateChanged += OnStateChanged;

        await ViewModel.LoadAsync();
        await ViewModel.StartHubAsync();

        await QueueViewModel.LoadAsync();
        await QueueViewModel.StartHubAsync();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ViewModel.StateChanged -= OnStateChanged;
        QueueViewModel.StateChanged -= OnStateChanged;
        _ = ViewModel.StopHubAsync();
        _ = QueueViewModel.StopHubAsync();
    }
}
