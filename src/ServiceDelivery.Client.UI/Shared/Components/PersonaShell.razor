@using Microsoft.AspNetCore.Components
@using MudBlazor
@using ServiceDelivery.Client.Core.Models
@using ServiceDelivery.Client.Core.ViewModels
@implements IDisposable

@* App-shell chrome for authenticated routes: a shared app bar (title + persona context + a menu
   affordance) above the page body, with the platform-adaptive PersonaMenu attached. The shell only
   renders chrome — it builds no menu data and calls no auth primitives directly; it binds to
   ShellViewModel. *@

<div data-testid="persona-shell" class="sd-shell">
    <MudAppBar Elevation="2" Class="sd-appbar" Fixed="false">
        <div class="sd-appbar__logo">🚐</div>
        <div>
            <div data-testid="appbar-title" class="sd-appbar__title">@ViewModel.Title</div>
            <div data-testid="appbar-context" class="sd-appbar__sub">@ContextSubtitle</div>
        </div>
        <MudSpacer />
        <div class="sd-appbar__controls">
            @* BUG-044/AC-3: the hamburger toggles the navigation DRAWER — a ServiceRep-mobile (Drawer)
               concern. On the AccountMenu (Desktop/Web) style the persona-avatar itself is the menu
               affordance (it opens the inline account panel), so the app-bar hamburger is a stray
               affordance the Requester/Dispatcher mockups do not depict — suppress it on AccountMenu. *@
            @if (ViewModel.IsMenuAffordanceVisible && ViewModel.MenuStyle == ShellMenuStyle.Drawer)
            {
                <MudIconButton data-testid="appbar-menu-affordance"
                               id="appbar-menu-affordance"
                               Icon="@MenuIcon"
                               Color="Color.Inherit"
                               OnClick="ViewModel.ToggleMenu"
                               Class="sd-appbar__action" />
            }
            @* BUG-044/AC-2: the trailing app-bar avatar is only the correct affordance on the Drawer
               (Mobile) style, where PersonaMenu's persona-avatar lives off-screen inside the drawer. On
               the AccountMenu (Desktop/Web) style PersonaMenu renders the persona-avatar inline as the
               clickable dropdown affordance, so rendering this one too would duplicate it — suppress it. *@
            @if (ViewModel.Menu is not null && ViewModel.MenuStyle == ShellMenuStyle.Drawer)
            {
                <MudAvatar data-testid="appbar-avatar" Class="sd-avatar">@Initials</MudAvatar>
            }
            @* BUG-044/AC-2 (cycle 2): the AccountMenu (Desktop/Web) persona surface — the single
               persona-avatar plus its inline dropdown panel — renders INSIDE the app bar's trailing
               controls, so the sole avatar sits in the trailing app-bar slot the mockup shows (not
               floating below the bar). The Drawer style keeps PersonaMenu as a full-screen sibling
               overlay below (rendered outside this app bar). *@
            @if (ViewModel.MenuStyle == ShellMenuStyle.AccountMenu)
            {
                <PersonaMenu ViewModel="ViewModel" />
            }
        </div>
    </MudAppBar>

    @if (ViewModel.MenuStyle == ShellMenuStyle.Drawer)
    {
        <PersonaMenu ViewModel="ViewModel" />
    }

    <main class="sd-shell__body">
        @Body
    </main>
</div>

@code {
    [Parameter, EditorRequired]
    public ShellViewModel ViewModel { get; set; } = default!;

    [Parameter]
    public RenderFragment? Body { get; set; }

    // Carries no rendered data. Its sole purpose is to give Blazor's parameter differ a changed
    // primitive value (int 0 -> 1) after MainLayout calls Shell.Load(profile), so the child render
    // cycle runs and PersonaMenu's `@if (ViewModel.Menu is not null)` is re-evaluated post-login.
    // Without it the unchanged ShellViewModel reference makes Blazor skip the child re-render (BUG-025).
    [Parameter]
    public int ShellVersion { get; set; }

    // BUG-044: a route may set the app-bar title AFTER this shell has rendered (the tracking page does so
    // in OnInitialized and again on a redirect). The ShellVersion / MainLayout mechanism only nudges a
    // re-render when the menu first loads (BUG-025/026) — it does NOT fire again on a mid-session title
    // override. Subscribing to TitleChanged gives Blazor the StateHasChanged nudge it needs to re-render
    // the appbar-title binding for those already-loaded shells. StateHasChanged matches the parameterless
    // Action signature directly, so no lambda wrapper is needed. Unsubscribed in Dispose.
    protected override void OnInitialized()
    {
        ViewModel.TitleChanged += StateHasChanged;
    }

    public void Dispose()
    {
        ViewModel.TitleChanged -= StateHasChanged;
    }

    private string ContextSubtitle => ViewModel.Subtitle ?? ViewModel.Menu?.VehicleContext ?? ViewModel.Menu?.ContextLine ?? string.Empty;

    private string MenuIcon => ViewModel.IsMenuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu;

    // Same initials derivation as PersonaMenu.razor — reproduced here (per BUG-033 review) rather
    // than extracted, keeping the small two-letter avatar label consistent across the app bar and
    // the menu surface without coupling the two components.
    private string Initials =>
        string.Concat((ViewModel.Menu?.Title ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]))
            .ToUpperInvariant();
}
